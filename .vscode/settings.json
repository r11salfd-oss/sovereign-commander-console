{
  // ==========================================
  // SOVEREIGN DEVELOPER ENVIRONMENT SETTINGS
  // Chain Key ID: 360ea36c28e66d9d
  // ==========================================

  // --- Editor Core & Hygiene ---
  "editor.formatOnSave": true,
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.detectIndentation": true,
  "editor.trimAutoWhitespace": true,
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "editor.inlayHints.enabled": "on",
  "editor.suggestSelection": "first",
  "editor.snippetSuggestions": "top",
  "editor.quickSuggestions": {
    "other": "on",
    "comments": "off",
    "strings": "on"
  },
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit",
    "source.fixAll": "explicit"
  },
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.eol": "\n",

  // --- File Associations & Nesting ---
  "files.associations": {
    "*.sql": "sql",
    "*.rules": "firestore-rules",
    "firestore.rules": "firestore-rules",
    "*.gql": "graphql"
  },
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "package.json": "package-lock.json, bun.lock, tsconfig.json, vite.config.ts, cloudbuild.yaml, Dockerfile, .dockerignore",
    "server.ts": "server.js, server.cjs, server.cjs.map",
    "*.ts": "${capture}.js, ${capture}.d.ts, ${capture}.map"
  },
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/dist": false,
    "**/node_modules": false
  },
  "files.watcherExclude": {
    "**/dist/**": true,
    "**/node_modules/**": true,
    "**/.git/**": true
  },

  // --- TypeScript & JavaScript Dev Engine ---
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "typescript.suggest.completeFunctionCalls": true,
  "typescript.inlayHints.parameterNames.enabled": "all",
  "typescript.inlayHints.parameterTypes.enabled": true,
  "typescript.inlayHints.variableTypes.enabled": true,
  "typescript.inlayHints.propertyDeclarationTypes.enabled": true,
  "typescript.inlayHints.functionLikeReturnTypes.enabled": true,
  "javascript.suggest.completeFunctionCalls": true,
  "javascript.inlayHints.parameterNames.enabled": "all",
  "[typescript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features",
    "editor.tabSize": 2
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "vscode.typescript-language-features",
    "editor.tabSize": 2
  },
  "[javascript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features",
    "editor.tabSize": 2
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features",
    "editor.tabSize": 2
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features",
    "editor.tabSize": 2
  },

  // --- Python Environment & Diagnostics ---
  "python.languageServer": "Jedi",
  "python.analysis.typeCheckingMode": "basic",
  "python.analysis.autoImportCompletions": true,
  "python.analysis.diagnosticMode": "workspace",
  "[python]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  },

  // --- SQL Server (mssql) & Database Intelligence ---
  "mssql.autoDisableNonTSqlLanguageService": true,
  "mssql.format.keywordCasing": "uppercase",
  "mssql.format.datatypeCasing": "uppercase",
  "mssql.intelliSense.enableIntelliSense": true,
  "mssql.intelliSense.enableQuickInfo": true,
  "mssql.intelliSense.enableSuggestions": true,
  "mssql.intelliSense.lowerCaseSuggestions": false,
  "mssql.query.executionTimeout": 60,
  "mssql.showBatchTime": true,
  "mssql.splitPaneSelection": "next",
  "mssql.resultsFontSize": 13,
  "mssql.resultsFontFamily": "Consolas, 'Courier New', monospace",
  "mssql.copyIncludeHeaders": true,
  "mssql.messagesDefaultOpen": false,
  "mssql.logDebugInfo": false,
  "mssql.connections": [
    {
      "server": "(localdb)\\MSSQLLocalDB",
      "database": "sovereign_enterprise_db",
      "authenticationType": "Integrated",
      "profileName": "Sovereign-LocalDB",
      "group": "Sovereign Enterprise Fleet",
      "savePassword": true,
      "connectTimeout": 30
    },
    {
      "server": "localhost",
      "database": "sovereign_enterprise_db",
      "authenticationType": "SqlLogin",
      "user": "sa",
      "profileName": "Sovereign-Dev-Server",
      "group": "Sovereign Enterprise Fleet",
      "savePassword": false,
      "connectTimeout": 30
    }
  ],
  "mssql.connectionGroups": [
    {
      "name": "Sovereign Enterprise Fleet",
      "id": "sovereign-root-group",
      "description": "Sovereign Command Console Database Fleet"
    }
  ],
  "[sql]": {
    "editor.defaultFormatter": "ms-mssql.mssql",
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.suggestOnTriggerCharacters": true,
    "editor.quickSuggestions": {
      "other": "on",
      "comments": "off",
      "strings": "off"
    }
  },

  // --- Telemetry & Notification Hygiene ---
  "telemetry.telemetryLevel": "off",

  // --- Tailwind CSS & UI Tooling ---
  "css.lint.unknownAtRules": "ignore",
  "tailwindCSS.includeLanguages": {
    "typescript": "javascript",
    "typescriptreact": "javascript"
  },
  "tailwindCSS.emmetCompletions": true,
  "tailwindCSS.validate": false,

  // --- Terminal Profiles (Windows) ---
  "terminal.integrated.defaultProfile.windows": "PowerShell"
}
