      "model": "antigravity/gemini-3.8-flash-high",
      "description": "\u0627\u0644\u0645\u0639\u0645\u0627\u0631\u064a \u0627\u0644\u0633\u064a\u0627\u062f\u064a \u0627\u0644\u0623\u0639\u0644\u0649 \u0644\u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u0642\u0631\u0627\u0631\u0627\u062a \u0627\u0644\u0645\u0639\u0645\u0627\u0631\u064a\u0629 \u0648\u0636\u0645\u0627\u0646 \u0627\u0644\u0627\u0645\u062a\u062b\u0627\u0644 \u0627\u0644\u062a\u0634\u0641\u064a\u0631\u064a",
