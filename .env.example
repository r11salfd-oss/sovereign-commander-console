# ==============================================================================
# 👑 SOVEREIGN COMMANDER CONSOLE - ENVIRONMENT CONFIGURATION TEMPLATE
# Authority: Supreme Sovereign Commander
# Chain Key ID: 360ea36c28e66d9d
# ==============================================================================

# Server Runtime Settings
PORT=3000
NODE_ENV=development

# Sovereign Cryptographic Chain Key
CHAIN_KEY_ID=360ea36c28e66d9d

# Google Gemini API Credentials
# NOTE: server.ts resolves Gemini_API first, then falls back to GEMINI_API_KEY.
# Setting either one is enough; if both are set, Gemini_API wins.
# Case matters on Linux: the alias is exactly `Gemini_API`, not `GEMINI_API`.
GEMINI_API_KEY=
Gemini_API=

# Google Cloud Platform & Cloud Run (Production CI/CD)
GCP_PROJECT_ID=
GCP_REGION=us-central1

# Firebase & Data Connect Configuration
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ==============================================================================
# OPTIONAL INTEGRATIONS
# Empty means "not configured". The capability reports itself as unconfigured
# (for example /api/health shows geminiGateway: "unconfigured" and status
# "degraded") instead of pretending to work. Nothing here is required to boot.
# ==============================================================================

# Azure OpenAI (optional model backend)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# OpenCode / Zen model providers (optional)
OPENCODE_API_KEY=
ZEN_API_KEY=

# Host prober: read-only server operations. No token means the prober is disabled.
HOST_PROBER_BASE_URL=
HOST_PROBER_TOKEN=
HOST_PROBER_TIMEOUT_MS=

# CLI execution endpoints are FAIL-CLOSED (HTTP 401) unless a token is provisioned.
SOVEREIGN_CLI_TOKEN_FILE=

# Token forwarded to spawned Sovereign CLI child processes (optional).
SOVEREIGN_TOKEN=
